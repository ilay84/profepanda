{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Example sentence block",
  "type": "object",
  "required": ["id", "type", "data"],
  "properties": {
    "id": { "type": "string" },
    "type": { "const": "example_sentence" },
    "style_variant": { "type": "string" },
    "data": {
      "type": "object",
      "required": ["segments_primary", "segments_translation"],
      "properties": {
        "language_primary": { "type": "string" },
        "language_translation": { "type": "string" },
        "segments_primary": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["text"],
            "properties": {
              "segment_id": { "type": "string" },
              "text": { "type": "string" },
              "marks": { "type": "array", "items": { "type": "string", "enum": ["bold", "italic"] } }
            }
          }
        },
        "segments_translation": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["text"],
            "properties": {
              "segment_id": { "type": "string" },
              "text": { "type": "string" },
              "marks": { "type": "array", "items": { "type": "string", "enum": ["bold", "italic"] } }
            }
          }
        },
        "audio": {
          "type": ["object", "null"],
          "properties": {
            "source": { "type": "string", "enum": ["url", "media"] },
            "src": { "type": "string" },
            "mime_type": { "type": "string" },
            "duration_seconds": { "type": "number" }
          }
        },
        "player_options": {
          "type": "object",
          "properties": {
            "allow_speed_control": { "type": "boolean" },
            "default_speed": { "type": "number" },
            "speed_steps": { "type": "array", "items": { "type": "number" } }
          }
        }
      }
    }
  },
  "additionalProperties": false
}
