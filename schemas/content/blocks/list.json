{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "List block",
  "type": "object",
  "required": ["id", "type", "data"],
  "properties": {
    "id": { "type": "string" },
    "type": { "const": "list" },
    "data": {
      "type": "object",
      "required": ["items"],
      "properties": {
        "ordered": { "type": "boolean", "default": false },
        "items": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["segments"],
            "properties": {
              "item_id": { "type": "string" },
              "segments": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": ["text"],
                  "properties": {
                    "segment_id": { "type": "string" },
                    "text": { "type": "string" },
                    "marks": { "type": "array", "items": { "type": "string", "enum": ["bold", "italic"] } },
                    "translations": { "type": "object", "additionalProperties": { "type": "string" } }
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "additionalProperties": false
}
