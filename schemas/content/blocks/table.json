{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Table block",
  "type": "object",
  "required": ["id", "type", "data"],
  "properties": {
    "id": { "type": "string" },
    "type": { "const": "table" },
    "data": {
      "type": "object",
      "required": ["columns", "rows"],
      "properties": {
        "columns": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "label"],
            "properties": {
              "id": { "type": "string" },
              "label": { "type": "string" }
            }
          }
        },
        "rows": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["row_id", "cells"],
            "properties": {
              "row_id": { "type": "string" },
              "cells": {
                "type": "object",
                "additionalProperties": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "required": ["text"],
                    "properties": {
                      "segment_id": { "type": "string" },
                      "text": { "type": "string" },
                      "marks": { "type": "array", "items": { "type": "string", "enum": ["bold", "italic"] } },
                      "translations": { "type": "object", "additionalProperties": { "type": "string" } }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "additionalProperties": false
}
