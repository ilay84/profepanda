{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Heading block",
  "type": "object",
  "required": ["id", "type", "data"],
  "properties": {
    "id": { "type": "string" },
    "type": { "const": "heading" },
    "style_variant": { "type": "string", "enum": ["h1", "h2", "h3", "h4", "h5", "h6"], "default": "h3" },
    "data": {
      "type": "object",
      "required": ["segments"],
      "properties": {
        "segments": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["text"],
            "properties": {
              "segment_id": { "type": "string" },
              "text": { "type": "string" },
              "marks": { "type": "array", "items": { "type": "string", "enum": ["bold", "italic"] } }
            }
          }
        }
      }
    }
  },
  "additionalProperties": false
}
