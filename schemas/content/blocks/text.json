{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Text block",
  "type": "object",
  "required": ["id", "type", "data"],
  "properties": {
    "id": { "type": "string" },
    "type": { "const": "text" },
    "style_variant": { "type": "string", "enum": ["body", "body_sm"], "default": "body" },
    "data": {
      "type": "object",
      "required": ["segments"],
      "properties": {
        "segments": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["text"],
            "properties": {
              "segment_id": { "type": "string" },
              "text": { "type": "string" },
              "marks": { "type": "array", "items": { "type": "string", "enum": ["bold", "italic"] } },
              "translations": { "type": "object", "additionalProperties": { "type": "string" } }
            }
          }
        }
      }
    }
  },
  "additionalProperties": false
}
